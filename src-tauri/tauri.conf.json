{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaBuCAD",
  "version": "0.1.0",
  "identifier": "com.bucala.mabucad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MaBuCAD",
        "width": 1600,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "transparent": true,
        "dragDropEnabled": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data: blob: http://asset.localhost; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Bucala",
    "copyright": "Copyright (c) 2026 Bucala",
    "category": "DeveloperTool",
    "shortDescription": "Parametric 3D/2D CAD system",
    "longDescription": "MaBuCAD is a parametric 3D/2D CAD system with a history-based feature tree, a constraint-driven 2D sketcher and a B-Rep geometric kernel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
